{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "bretts-mod-mail",
  "title": "Brett's Mod Mail",
  "description": "Mod mail reader and responder — triage, template replies, and auto-respond",
  "requiredPermissions": ["read", "submit", "modposts"],
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onModMail": "/internal/triggers/on-mod-mail"
  },
  "server": {
    "directory": "server"
  },
  "clientPages": {
    "App": {
      "jsx": "client/App.jsx"
    }
  },
  "resources": {
    "css": ["styles.css"]
  }
}
